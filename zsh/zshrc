# ~/.zshrc — managed by ~/.dotfiles (edit there, not here)

# --- Homebrew ---------------------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# --- History ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE SHARE_HISTORY INC_APPEND_HISTORY

# --- Options & completion ---------------------------------------------------
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP
autoload -Uz compinit && compinit -C
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# --- Environment ------------------------------------------------------------
export EDITOR="code --wait"
export LANG="en_US.UTF-8"
export KUBE_EDITOR="$EDITOR"
export PATH="$HOME/.local/bin:${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# --- Tool init (each guarded so a missing tool never breaks the shell) -----
command -v mise     >/dev/null && eval "$(mise activate zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
command -v direnv   >/dev/null && eval "$(direnv hook zsh)"
command -v fzf      >/dev/null && source <(fzf --zsh)
command -v kubectl  >/dev/null && source <(kubectl completion zsh)

[[ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# --- Aliases & functions ----------------------------------------------------
DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
source "$DOTFILES/zsh/aliases.zsh"
source "$DOTFILES/zsh/functions.zsh"

# --- Machine-local overrides (not in git) -----------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# syntax highlighting must be sourced last
[[ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
